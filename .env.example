SECRET_KEY=cambia-esto-en-produccion
FLASK_DEBUG=1

# Segundos de caché para no saturar Yahoo Finance
QUOTE_CACHE_TTL=15
CANDLE_CACHE_TTL=60

# Envío de emails vía Resend (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Imágenes optimizadas vía Cloudinary (https://console.cloudinary.com/settings/api-keys)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Alpha Vantage como proveedor de precios del Graficador (opcional)
# Clave gratuita en https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_CACHE_TTL=300

# Login con InsForge (https://insforge.dev)
# URL: campo oss_host de .insforge/project.json. Anon key: npx @insforge/cli secrets get ANON_KEY
INSFORGE_URL=
INSFORGE_ANON_KEY=
# 1 = /app/ exige iniciar sesión; 0 = abierto
AUTH_REQUIRED=1
SESSION_DAYS=7
# API key del proyecto (solo servidor, nunca al frontend): campo api_key de .insforge/project.json
INSFORGE_API_KEY=

# --- App "Riesgo moainvest" (datos en MotherDuck + MLflow) ---
# Token de MotherDuck: https://app.motherduck.com -> Settings -> Tokens
MOTHERDUCK_TOKEN=
# Destino DuckDB. "md:" = MotherDuck. Para pruebas locales: ":memory:" o "local.duckdb"
OLAP_TARGET=md:
OLAP_DATABASE=riesgo_olap
# Límites del motor local (el cómputo pesado lo hace MotherDuck en la nube)
OLAP_MEMORY_LIMIT=2GB
OLAP_THREADS=4
# Instrumento de la ingesta diaria (extract.py): SPY = S&P 500, la tabla raw_spy_daily que lee el panel.
# La ingesta de Dukascopy (ingest.py, forex) se usa pasando --instrument EURUSD explícito.
# Lado de oferta de Dukascopy:
OLAP_DEFAULT_INSTRUMENT=SPY
OLAP_DEFAULT_OFFER_SIDE=BID
OLAP_FETCH_MAX_RETRIES=7
OLAP_LIVE_LAG_SECONDS=5
OLAP_LIVE_POLL_SECONDS=10
# Dataset de crédito: "openml:credit-g" o "csv:/ruta/al/archivo.csv"
OLAP_CREDIT_SOURCE=openml:credit-g
OLAP_CREDIT_TARGET_COLUMN=class
OLAP_CREDIT_POSITIVE_LABEL=bad
OLAP_CREDIT_TABLE=applicants
# URL de la UI de MLflow que enlaza el panel (uv run mlflow ui --port 5001)
MLFLOW_UI_URL=http://127.0.0.1:5001
